[Unit]
Description=RCAgent local mock backend for the Kylin MCP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=TEST_SCENARIO_LISTEN=127.0.0.1:19888
Environment=TEST_SCENARIO_EVIDENCE=/var/lib/rcagent-mcp-mock/evidence
ExecStart=/opt/kylin/rcagent-mcp-mock/bin/rcagent-mcp-mock
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
