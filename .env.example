# OpenAI API Configuration
OPENAI_API_KEY=""
OPENAI_PROJECT_ID=""
OPENAI_ADMIN_API_KEY=""

# RCAgent model endpoint (OpenAI-compatible Chat Completions)
RCAGENT_LLM_API_KEY=""
RCAGENT_LLM_BASE_URL=""
RCAGENT_LLM_MODEL="gpt-5-mini"
RCAGENT_LLM_ADVANCED_MODEL="gpt-5.1"
# Explicit submission protocol. function_calling works with the tested Token Plan endpoint.
# Use json_schema only after checking that the selected endpoint supports it.
RCAGENT_LLM_STRUCTURED_OUTPUT_METHOD="function_calling"
# Optional override for the advanced model; unset means inherit the setting above.
# RCAGENT_LLM_ADVANCED_STRUCTURED_OUTPUT_METHOD="json_schema"

# Telegram Notification (Optional)
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# LangSmith Tracing (Optional but Recommended)
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="RCAgent"

# SRE Agent Configuration
# Budget for individual RCA workers
MAX_TOOL_CALLS="8"
# Number of tasks to execute in parallel
RCA_TASKS_PER_ITERATION="3"
# Starting service for trace analysis (e.g., 'frontend' or 'nginx')
TRACE_SERVICE_STARTING_POINT="frontend"
# Safety limit for daily token usage
MAX_DAILY_OPENAI_TOKEN_LIMIT="2000000"

# Observability Tools & Cluster Access
PROMETHEUS_SERVER_URL="http://localhost:9090"
JAEGER_URL="http://localhost:16686"
TARGET_NAMESPACE="default"

# Neo4j Datagraph Configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER=""
NEO4J_PASSWORD=""

# AIOpsLab Integration
# Directory where AIOpsLab is installed
AIOPSLAB_DIR="/path/to/AIOpsLab"
# Directory to store experiment results
RESULTS_PATH="Results"

# Incident workspace (absolute path; WSL uses /mnt/... or /tmp/...)
# RCAGENT_WORKSPACE_ROOT=/absolute/path/to/incident-workspaces
RCAGENT_ALLOWED_NAMESPACES=*
RCAGENT_IDENTITY_MAX_ATTEMPTS=2
RCAGENT_IDENTITY_TTL_SECONDS=60
RCAGENT_WORKER_MAX_MODEL_STEPS=16
RCAGENT_SUPERVISOR_MAX_ROUNDS=3
RCAGENT_SUPERVISOR_MAX_READS=8
RCAGENT_MAX_NO_PROGRESS_ROUNDS=2
RCAGENT_INVESTIGATION_TIMEOUT_SECONDS=1800
RCAGENT_MODEL_TIMEOUT_SECONDS=180
# Planning has its own request allowance; the shared SDK timeout also permits it.
RCAGENT_PLANNER_MODEL_TIMEOUT_SECONDS=300
RCAGENT_SUPERVISOR_MODEL_TIMEOUT_SECONDS=300
# Bounded active stage -> packet -> final selection recovery after report timeout.
RCAGENT_SUPERVISOR_FINALIZATION_MAX_STEPS=4
RCAGENT_CONTEXT_MAX_CHARS=96000
# Efficiency target only; necessary content can expand to the independent ceiling.
RCAGENT_CONTEXT_BUDGET_POLICY=soft
# Independent serialized-request safety ceiling, NOT a verified model token window.
RCAGENT_CONTEXT_HARD_MAX_CHARS=512000
# Optional role handoff may fail without discarding a valid outer result.
# Rejected drafts remain rejected; force true only for explicit strict comparisons.
RCAGENT_STAGE_HANDOFF_REQUIRED=false
RCAGENT_STAGE_REPAIR_MAX_CHARS=32768
# strict restores the old single-limit behavior for comparisons/rollback.
RCAGENT_CONTEXT_BUDGET_ENABLED=true
RCAGENT_CONTEXT_VIEW_MODE=compact
# Observe saves local selection candidates without changing the model path.
# Active meters canonical v2; soft target and engineering ceiling are separate.
RCAGENT_CONTEXT_LIFECYCLE_MODE=observe
RCAGENT_REQUEST_BUDGET_BASIS=v2
RCAGENT_RATE_LIMIT_POLICY=stop_run
RCAGENT_CONTEXT_HISTORY_RECENT_BATCHES=2
RCAGENT_CONTEXT_READ_MAX_CHARS=4000
RCAGENT_SERVICE_FALLBACK_MAX_PODS=3
RCAGENT_MODEL_MAX_IN_FLIGHT=1
RCAGENT_MODEL_MIN_INTERVAL_SECONDS=2
RCAGENT_MODEL_MAX_RETRIES=2
RCAGENT_SUPERVISOR_MAX_CORRECTIONS=1
RCAGENT_INVESTIGATION_SKILLS_ENABLED=true
RCAGENT_SKILL_READ_EXTRA_ROUNDS=3

# PRD22 R3 common phase budgets (old WORKER_MAX_MODEL_STEPS applies to legacy entrypoints).
RCAGENT_WORKER_EXPLORATION_STEPS=14
RCAGENT_SUPERVISOR_EXPLORATION_STEPS=8
RCAGENT_INVESTIGATION_CONSOLIDATION_STEPS=4
RCAGENT_INVESTIGATION_REPAIR_STEPS=2
# Optional explicit local archive manifest; never mount configuration/credentials.
# RCAGENT_INVESTIGATION_HISTORY_ROOT=/absolute/path/to/selected/investigations
# RCAGENT_INVESTIGATION_HISTORY_MANIFEST=/absolute/path/to/history-manifest.json

# R5 owned Python loop (WSL); OpenCode is NOT a runtime dependency.
# Leave empty to start an owned authenticated loopback v5 gateway.
RCAGENT_NATIVE_MCP_URL=
RCAGENT_NATIVE_MCP_TOKEN=
# RCAGENT_V5_GATEWAY_BINARY=/absolute/path/to/current/v5/gateway
# RCAGENT_V5_QUERIES_HTTP_URL=http://10.44.56.107:30634
# RCAGENT_V5_CONTROLLER_HTTP_URL=http://10.44.56.107:30417
# WORKER_* / SUPERVISOR_* / CONTEXT_* legacy quotas do not control the native kernel.

# Owned transport concurrency and failure detection; not investigation budgets.
RCAGENT_NATIVE_CONCURRENCY=8
RCAGENT_NATIVE_WORKER_CONCURRENCY=5
RCAGENT_NATIVE_MODEL_CONCURRENCY=1
RCAGENT_NATIVE_MCP_TIMEOUT=300
RCAGENT_INVESTIGATION_IDLE_TIMEOUT=300
# Set only from known current provider model capacity; unknown defaults to unset.
# RCAGENT_MODEL_CONTEXT_TOKENS=
# RCAGENT_MODEL_OUTPUT_RESERVE_TOKENS=
# MCP profile: native (default), business, or integrated (both explicit sources).
# business never falls back to native; integrated binds each task to one source family.
RCAGENT_MCP_PROFILE=native
RCAGENT_BUSINESS_MCP_URL=
RCAGENT_BUSINESS_MCP_TOKEN=
# Optional provenance for the business service; not proof of shared storage/identity.
# RCAGENT_BUSINESS_BACKEND_URL=http://10.44.56.107:30634
# Optional generated concept navigation; absence/malformed input does not block a run.
# RCAGENT_CONCEPTS_PATH=/absolute/path/to/generated/concepts.json
# RCAGENT_CONCEPT_NODE=/absolute/path/to/existing/node

# Optional external server for historical legacy_stdio experiments
RCAGENT_LEGACY_MCP_SERVER=
