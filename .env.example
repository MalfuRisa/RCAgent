# OpenAI-compatible model endpoint with streaming tool calls.
RCAGENT_LLM_BASE_URL=
RCAGENT_LLM_MODEL=
RCAGENT_LLM_API_KEY=
RCAGENT_LLM_STRUCTURED_OUTPUT_METHOD=function_calling

# Streamable HTTP MCP profile: native, business or integrated.
RCAGENT_MCP_PROFILE=native
RCAGENT_NATIVE_MCP_URL=
RCAGENT_NATIVE_MCP_TOKEN=
RCAGENT_BUSINESS_MCP_URL=
RCAGENT_BUSINESS_MCP_TOKEN=
# RCAGENT_BUSINESS_BACKEND_URL=

# Optional: start a local native HTTP gateway when no native MCP URL is set.
# RCAGENT_V5_GATEWAY_BINARY=/absolute/path/to/gateway
# RCAGENT_V5_QUERIES_HTTP_URL=
# RCAGENT_V5_CONTROLLER_HTTP_URL=

# Investigation runtime.
# RCAGENT_WORKSPACE_ROOT=/absolute/path/to/run-storage
RCAGENT_NATIVE_CONCURRENCY=8
RCAGENT_NATIVE_WORKER_CONCURRENCY=5
RCAGENT_NATIVE_MODEL_CONCURRENCY=1
RCAGENT_INVESTIGATION_CONNECT_TIMEOUT=30
RCAGENT_INVESTIGATION_IDLE_TIMEOUT=300
RCAGENT_NATIVE_MCP_TIMEOUT=300
RCAGENT_PLANNER_READ_BUDGET_CHARS=8000
# RCAGENT_MODEL_CONTEXT_TOKENS=
# RCAGENT_MODEL_OUTPUT_RESERVE_TOKENS=
# RCAGENT_CONCEPT_NODE=/absolute/path/to/node
# RCAGENT_CONCEPTS_PATH=/absolute/path/to/concepts.json
